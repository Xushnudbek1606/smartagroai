# ============================================================
# SmartAgroAI — environment configuration template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---- database ----
POSTGRES_USER=smartagro
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=smartagro
# Local development (outside Docker) example:
# DATABASE_URL=postgresql+psycopg://smartagro:change-me-db-password@localhost:5432/smartagro
DATABASE_URL=postgresql+psycopg://smartagro:change-me-db-password@db:5432/smartagro

# ---- security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ENVIRONMENT=development

# ---- telegram bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# internal shared secret between bot and backend; generate your own:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- weather (OpenWeatherMap) ----
WEATHER_API_KEY=
WEATHER_PROVIDER=openweathermap

# ---- AI plant diagnosis ----
# AI_PROVIDER: none | openai | anthropic | custom
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
# For OpenAI-compatible gateways (Ollama, OpenRouter, vLLM...):
AI_CUSTOM_BASE_URL=

# ---- urls ----
FRONTEND_URL=http://localhost:8080
FRONTEND_PORT=8080
BACKEND_INTERNAL_URL=http://localhost:8000

# ---- storage ----
UPLOAD_STORAGE_PATH=./uploads

# ---- cache ----
REDIS_URL=redis://localhost:6379/0

# ---- initial admin seeding (optional) ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
